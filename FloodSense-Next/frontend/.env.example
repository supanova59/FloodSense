# Leave unset for browser-session demo storage.
# When the backend is ready: e.g. https://your-development-api.example/api
# This is a PUBLIC API URL, never a database password or privileged key.
NEXT_PUBLIC_API_BASE_URL=

# Selected street backend origin WITHOUT /api. Server-only variable.
# Keep NEXT_PUBLIC_API_BASE_URL empty for the scenario planner.
BACKEND_URL=http://127.0.0.1:5000

# Public socket origin only (never credentials); optional, polling remains available.
NEXT_PUBLIC_STREET_SOCKET_URL=http://127.0.0.1:5000
